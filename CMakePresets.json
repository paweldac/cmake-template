{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{PROJECT_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MEMORY_SANITIZER": "None",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitizer",
      "displayName": "RelWithDebInfo with sanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0,
      "targets": [
        "cmake-template.tests_build",
        "cmake-template.app"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0,
      "targets": [
        "cmake-template.tests_build",
        "cmake-template.app"
      ]
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer",
      "jobs": 0,
      "targets": [
        "cmake-template.tests_build",
        "cmake-template.app"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "scheduleRandom": true,
        "noTestsAction": "error"
      }
    }
  ]
}
